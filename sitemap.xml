---
layout: null
permalink: /sitemap.xml
sitemap: false
---
{%- comment -%}
Written out rather than generated by a plugin: the live builder ignores the
Gemfile, so a plugin-produced sitemap is one that cannot be verified locally.
This lists the real pages of the site in both languages — a page qualifies by
having a `ref`, which the redirect stubs and the JSON endpoint deliberately lack —
and declares each one's counterpart, so a crawler is told about both languages
from the sitemap as well as from the page.
{%- endcomment -%}
{%- assign pages = site.pages | where_exp: "p", "p.ref" | where_exp: "p", "p.sitemap != false" | sort: "url" -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for p in pages %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
{%- assign counterpart = pages | where: "ref", p.ref | where_exp: "q", "q.lang != p.lang" | first %}
    <xhtml:link rel="alternate" hreflang="{{ p.lang }}" href="{{ p.url | absolute_url }}"/>
{%- if counterpart %}
    <xhtml:link rel="alternate" hreflang="{{ counterpart.lang }}" href="{{ counterpart.url | absolute_url }}"/>
{%- endif %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ '/' | absolute_url }}"/>
  </url>
{%- endfor %}
</urlset>
